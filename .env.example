# Copy to .env for local development: cp .env.example .env

# development | production
APP_ENV=development

# debug | info | warn | error
LOG_LEVEL=debug

HTTP_PORT=8080
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s

# Used by the app.
DATABASE_URL=postgres://beebase:beebase@localhost:5434/beebase_hive?sslmode=disable
DATABASE_CONNECT_TIMEOUT=5s

# Used by docker-compose to provision the postgres container.
POSTGRES_USER=beebase
POSTGRES_PASSWORD=beebase
POSTGRES_DB=beebase_hive

# Used only by `make test-integration`, never by the app itself.
TEST_DATABASE_URL=postgres://beebase:beebase@localhost:5434/beebase_hive_test?sslmode=disable

# Required: auth-service's public key endpoint, used to verify access
# tokens without ever holding a key that could mint one.
AUTH_JWKS_URL=http://localhost:8081/.well-known/jwks.json

# Required: apiary-service's base URL. A hive can only be created under
# an apiary the caller owns; this service confirms that by forwarding the
# caller's own access token to apiary-service's GET /api/v1/apiaries/{id}.
APIARY_SERVICE_URL=http://localhost:8082

# Required: inspection-service's and media-service's base URLs. Deleting a
# hive cascades to its inspections and media; this service asks each to
# delete everything under the hive before hard-deleting it.
INSPECTION_SERVICE_URL=http://localhost:8084
MEDIA_SERVICE_URL=http://localhost:8085

# `docker compose up` (via beebase-gateway) overrides all of the above to
# in-network addresses — you don't need to change them for that path.

# Required: the gateway's externally reachable base URL, used to build
# the image_url returned for each image (PUBLIC_BASE_URL +
# "/api/v1/media/{id}/download"). Unlike the *_SERVICE_URL settings
# above, this one is handed to clients, so it must resolve for them, not
# just for server-to-server calls — it must stay the gateway's address
# even under `docker compose up`, which does NOT override it.
PUBLIC_BASE_URL=http://localhost:8080
